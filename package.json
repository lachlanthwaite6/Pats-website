{
  "name": "flipped-energy-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run typecheck && wrangler deploy --dry-run --outdir .build",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "jose": "6.2.12",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260914.1",
    "@types/node": "26.5.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "wrangler": "4.131.2"
  }
}
