{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flipped-energy-dashboard",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "vars": { "DATA_ACCESS": "password", "MAX_SNAPSHOT_BYTES": "900000" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flipped-energy",
      "database_id": "23e17601-ea7e-42dc-8db9-bce8a5f3fa2f",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
